# server/.env 로 복사해서 값을 채운다 (.env 는 git 에 올라가지 않는다)
# 공공데이터포털 「기상청_지상(종관, ASOS) 일자료 조회서비스」 일반 인증키(Decoding 값). 없으면 내장 24개 지점 데이터로만 동작
KMA_SERVICE_KEY=
# 검토 저장소 SQLite 파일 위치 (Docker 에서는 /data/reviews.db 볼륨)
# DEMO_DB=/data/reviews.db
# 기상 캐시 디렉터리 (Docker 에서는 /data/cache 볼륨)
# DEMO_CACHE_DIR=/data/cache
# LLM 서술·매핑 보정 모델 (claude CLI 가 있는 호스트에서만 동작)
# DEMO_LLM_MODEL=sonnet
# 선택: OpenAI 임베딩으로 벡터 검색 교체
# OPENAI_API_KEY=
