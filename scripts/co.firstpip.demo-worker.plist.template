<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.firstpip.demo-worker</string>

  <!-- __WORKER_DIR__ / __NODE_BIN__ 은 install-launchd.sh 가 치환한다. -->
  <key>WorkingDirectory</key>
  <string>__WORKER_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__WORKER_DIR__/node_modules/tsx/dist/cli.mjs</string>
    <string>index.ts</string>
  </array>

  <!-- 로그인 시 자동 시작 + 죽으면 재시작. 맥북이 잠들면 어차피 멈추므로
       heartbeat 로 살아있는지 표시하는 게 짝이다 (T8.12). -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- 즉시 재시작 폭주 방지 -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/demo-worker.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/demo-worker.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- GITHUB_TOKEN 은 plist 에 넣지 않는다 (평문 저장 회피).
         worker/.env.local 에 두면 shared/env.ts 가 읽는다. -->
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
