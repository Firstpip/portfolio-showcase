{
  "name": "demo-runtime-next-static",
  "private": true,
  "version": "0.1.0",
  "description": "Next.js 14 App Router + static export runtime. 공고가 Next.js 를 요구할 때(strict/preferred) 사용. output:'export' 라 서버 없이 GitHub Pages 로 그대로 서빙된다. React 18 과 짝을 맞추려고 Next 15 가 아니라 14.2 를 쓴다 (15 는 React 19 전제).",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ./scripts/finalize.mjs",
    "start": "next start"
  },
  "dependencies": {
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.460.0",
    "sonner": "^1.7.0",
    "zod": "^3.23.8",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  }
}
