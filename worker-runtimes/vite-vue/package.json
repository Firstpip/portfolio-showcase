{
  "name": "demo-runtime-vite-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vite + Vue 3 + TS + Tailwind runtime. 공고가 Vue 를 요구할 때(strict/preferred) 사용. 데모 빌드 시 임시 디렉토리에 cp -r 후 src/ + tailwind.config 만 LLM 이 채우고 npm run build → dist/ 추출.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "pinia": "^2.2.6",
    "lucide-vue-next": "^0.460.0",
    "vue-sonner": "^1.2.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
